# ¡Twins! CLIENT environment variables (bundled into the app, safe to commit).
# Copy this file to .env and fill in your Supabase project's PUBLIC values.
# The app runs fine in mock/demo mode with .env absent or these left blank -
# see README.md "Development mode without credentials".

# Supabase project URL, e.g. https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase "anon"/"publishable" key (Project Settings -> API).
# This is safe to ship in the client - it only works together with RLS.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: custom URL scheme used for deep links (twins://...).
EXPO_PUBLIC_APP_SCHEME=twins

# ---------------------------------------------------------------------------
# SERVER-SIDE secrets do NOT go here. They live in `supabase/.env` (git-ignored,
# never bundled): SUPABASE_SECRET_KEY, GROQ_API_KEY, and the DB connection
# string. See supabase/.env (create from the values in Project Settings) and
# docs/SUPABASE_SETUP.md for the deploy + seed flow.
# ---------------------------------------------------------------------------
